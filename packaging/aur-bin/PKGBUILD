# Maintainer: Paul Waldrop <pwaldrop2@gmail.com>
pkgname=absotui-bin
pkgver=0.11.6
pkgrel=1
pkgdesc="A fun, fast, and intuitive TUI client for Audiobookshelf"
arch=('x86_64' 'aarch64')
url="https://github.com/pdwaldrop/absotui"
license=('GPL-3.0-only')
depends=('vlc')
optdepends=(
    'mpv: alternative player (Settings > Player)'
    'xdg-utils: opens your browser for SSO sign-in'
    'kitty: only for the optional cvlc_term setting (VLC)'
    'gnu-netcat: only for the optional cvlc_term setting (VLC)'
)
provides=('absotui')
conflicts=('absotui')
options=(!debug strip)
install=absotui-bin.install
source_x86_64=(
    "${pkgname}-${pkgver}-x86_64.tar.gz::https://github.com/pdwaldrop/absotui/releases/download/v${pkgver}/absotui-x86_64-unknown-linux-gnu.tar.gz"
)
source_aarch64=(
    "${pkgname}-${pkgver}-aarch64.tar.gz::https://github.com/pdwaldrop/absotui/releases/download/v${pkgver}/absotui-aarch64-unknown-linux-gnu.tar.gz"
)
source=(
    "config.example-${pkgver}.toml::https://github.com/pdwaldrop/absotui/releases/download/v${pkgver}/config.example.toml"
    "absotui-${pkgver}.desktop::https://github.com/pdwaldrop/absotui/releases/download/v${pkgver}/absotui.desktop"
    "absotui-${pkgver}.svg::https://github.com/pdwaldrop/absotui/releases/download/v${pkgver}/absotui.svg"
)
sha256sums_x86_64=('0368d2eaf1d1031eb6d11eb9da1fb6d967c509a73b2ef770077303477b30da48')
sha256sums_aarch64=('d237c7d6f23357a264822d83f0d98b9daca1976ab0a3e062fc1861e253a114cf')
sha256sums=('3c03effccaa0e3252c581ca3008c3b6c4f285f41d387cb83ca99e4afa4a617d7'
            '31112a9600a4448c75a94b4f276d14140aed4269a0e72092d3303e9ff34a421f'
            '2fee11a294408461a228d7313a64f64565b171dc2281a354b92690d756d9e509')

package() {
    cd "$srcdir"

    install -Dm755 "absotui" "$pkgdir/usr/bin/absotui"
    install -Dm644 "config.example-${pkgver}.toml" "$pkgdir/usr/share/absotui/config.example.toml"
    install -Dm644 "absotui-${pkgver}.desktop" "$pkgdir/usr/share/applications/absotui.desktop"
    install -Dm644 "absotui-${pkgver}.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/absotui.svg"
}
